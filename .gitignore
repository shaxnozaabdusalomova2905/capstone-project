# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# Jupyter / Colab
.ipynb_checkpoints/
*.ipynb_checkpoints

# Virtual environments
venv/
env/
.venv/
ENV/

# Datasets (usually too large for git, download separately)
data/*
!data/raw/
!data/processed/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Keep the small metadata that records the exact split, but not the images
!data/processed/manifest.csv
!data/processed/class_weights.json
datasets/
*.zip
*.tar
*.tar.gz

# Model weights. Large ones stay out of git history, but the demo has to be
# runnable from a fresh clone, so a small set of weights is kept:
#   - all five baseline CNN folds (1.6 MB each, 7.8 MB total)
#   - one ResNet18 fold (44.7 MB) - enough to make predictions
# The remaining ResNet18 folds are regenerated by running Notebook 04.
*.pt
*.pth
*.onnx
*.h5
!models/baseline_cnn_fold*.pt
!models/resnet18_fold2.pt
!models/*_config.json
weights/
runs/

# Logs
*.log
logs/

# Results: metrics and figures are small and worth keeping as a record of
# what each model achieved. Only bulky artifacts are excluded.
outputs/**/*.pt
outputs/**/*.pth
outputs/**/*.zip

# Environment/secrets
.env
*.pem
*.key

# IDE
.vscode/
.idea/
*.swp
