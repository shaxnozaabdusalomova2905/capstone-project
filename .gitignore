# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# Jupyter / Colab
.ipynb_checkpoints/
*.ipynb_checkpoints

# Virtual environments
venv/
env/
.venv/
ENV/

# Datasets (usually too large for git, download separately)
data/*
!data/raw/
!data/processed/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Keep the small metadata that records the exact split, but not the images
!data/processed/manifest.csv
!data/processed/class_weights.json
datasets/
*.zip
*.tar
*.tar.gz

# Model weights (large files, don't belong in git history)
*.pt
*.pth
*.onnx
*.h5
weights/
runs/

# Logs
*.log
logs/

# Results: metrics and figures are small and worth keeping as a record of
# what each model achieved. Only bulky artifacts are excluded.
outputs/**/*.pt
outputs/**/*.pth
outputs/**/*.zip

# Environment/secrets
.env
*.pem
*.key

# IDE
.vscode/
.idea/
*.swp
